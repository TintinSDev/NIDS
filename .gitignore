cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
# IDE
.idea/
.vscode/

# OS
.DS_Store

# Logs and temporary files
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated data
data/raw/
data/interim/
data/processed/

# Runtime artifacts
*.sqlite3
EOF
.env.example
