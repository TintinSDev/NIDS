                    ))}
                  </div>

                  {/* CLASS PERFORMANCE + DRIFT */}
                  <div className="grid grid-cols-1 xl:grid-cols-5 gap-5">

                    <div className="glass-card rounded-2xl p-5 xl:col-span-3">
                      <div className="flex items-center justify-between mb-1">
                        <h2 className="text-sm font-semibold text-white">
                          Per-class detection performance
                        </h2>
                        <span className="text-[10px] text-cyan-300">
                          V3 · Held-out test
                        </span>
                      </div>
                      <p className="text-xs text-slate-400 mb-5">
                        Detection rate across the four evaluated traffic families
                      </p>

                      <div className="grid grid-cols-12 gap-2 px-3 pb-2 text-[10px] uppercase tracking-wide text-slate-500 border-b border-white/10">
                        <span className="col-span-4">Class</span>
                        <span className="col-span-3 text-right">Detected</span>
                        <span className="col-span-3 text-right">Support</span>
                        <span className="col-span-2 text-right">Recall</span>
                      </div>

                      {[
                        { name: "Benign", detected: 52022, support: 52486, recall: "99.12%", color: "bg-emerald-400" },
                        { name: "DoS / DDoS", detected: 12799, support: 12800, recall: "99.99%", color: "bg-rose-400" },
                        { name: "Brute Force", detected: 908, support: 908, recall: "100%", color: "bg-amber-400" },
                        { name: "PortScan", detected: 191, support: 193, recall: "98.96%", color: "bg-cyan-400" }
                      ].map((item) => (
                        <div
                          key={item.name}
                          className="grid grid-cols-12 gap-2 items-center px-3 py-4 border-b border-white/5 text-xs"
                        >
                          <span className="col-span-4 text-slate-300 font-medium">
                            {item.name}
                          </span>
                          <span className="col-span-3 text-right text-slate-300 tabular-nums">
                            {item.detected.toLocaleString()}
                          </span>
                          <span className="col-span-3 text-right text-slate-400 tabular-nums">
                            {item.support.toLocaleString()}
                          </span>
                          <span className="col-span-2 text-right text-emerald-400 font-semibold tabular-nums">
                            {item.recall}
                          </span>
                          <div className="col-span-12 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                            <div
                              className={`h-full rounded-full ${item.color}`}
                              style={{ width: item.recall }}
                            />
                          </div>
                        </div>
                      ))}

                      <p className="text-[10px] text-slate-500 mt-4">
                        Detection rate is calculated from the V3 end-to-end
                        held-out evaluation. Benign shows the correctly
                        classified benign share.
                      </p>
                    </div>

                    <div className="glass-card rounded-2xl p-5 xl:col-span-2">
                      <div className="flex items-center justify-between">
                        <h2 className="text-sm font-semibold text-white">
                          Feature drift
                        </h2>
                        <span className="px-2.5 py-1 rounded-full text-[10px] bg-amber-500/10 text-amber-300 border border-amber-500/20">
                          Not measured
                        </span>
                      </div>
                      <p className="text-xs text-slate-400 mt-1">
                        Population stability monitoring
                      </p>

                      <div className="mt-6 rounded-xl border border-dashed border-white/10 p-5 text-center">
                        <div className="text-3xl text-slate-600 mb-3">⌁</div>
                        <div className="text-sm text-slate-300">
                          Drift baseline not configured
                        </div>
                        <p className="text-xs text-slate-500 mt-2 leading-relaxed">
                          PSI monitoring requires a reference feature
                          distribution and periodic comparison against
                          incoming traffic. No drift score is reported yet.
                        </p>
                      </div>

                      <div className="mt-5 space-y-3 text-xs">
                        <div className="flex justify-between">
                          <span className="text-slate-400">Feature schema</span>
                          <span className="text-slate-200 font-mono">
                            {modelInfo.schema_name || "features_v1.json"}
                          </span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-slate-400">Aligned features</span>
                          <span className="text-cyan-300">
                            {modelInfo.feature_count || 52}
                          </span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-slate-400">Reference baseline</span>
                          <span className="text-slate-500">Not configured</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* DEPLOYMENT + THRESHOLDS */}
                  <div className="grid grid-cols-1 xl:grid-cols-5 gap-5">

                    <div className="glass-card rounded-2xl p-5 xl:col-span-3">
                      <h2 className="text-sm font-semibold text-white">
                        Model deployment
                      </h2>
                      <p className="text-xs text-slate-400 mt-1 mb-4">
                        Currently loaded V3 ensemble artifacts
                      </p>

                      <div className="flex items-center justify-between rounded-xl bg-white/[0.03] border border-white/5 p-4 mb-4">
                        <div>
                          <div className="text-xs text-slate-400">
                            Active artifact version
                          </div>
                          <div className="text-2xl font-bold text-white mt-1">
                            {modelInfo.active_version || "v3.0.0"}
                          </div>
                          <div className="text-xs text-emerald-400 mt-1">
                            Platt-calibrated probabilities
                          </div>
                        </div>
                        <span className="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-xs">
                          Deployed
                        </span>
                      </div>

                      <div className="divide-y divide-white/5">
                        {(modelInfo.detectors || []).map((d) => (
                          <div
                            key={d.name}
                            className="py-3 flex items-center justify-between gap-3"
                          >
                            <div>
                              <div className="text-xs font-semibold text-slate-200">
                                {d.name}
                              </div>
                              <div className="text-xs text-slate-500 mt-1">
                                {d.role}
                              </div>
                            </div>
                            <span className="shrink-0 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-[10px]">
                              Loaded
                            </span>
                          </div>
                        ))}
                      </div>

                      <div className="border-t border-white/10 mt-3 pt-3 text-xs text-slate-500">
                        Evaluation snapshot: V3 held-out test · 66,387 flows
                      </div>
                    </div>

                    <div className="glass-card rounded-2xl p-5 xl:col-span-2">
                      <h2 className="text-sm font-semibold text-white">
                        Detection configuration
                      </h2>
                      <p className="text-xs text-slate-400 mt-1 mb-5">
                        Active V3 decision thresholds
                      </p>

                      {[
                        { name: "XGBoost threshold", value: "0.000756831956" },
                        { name: "Random Forest threshold", value: "0.009017518885" },
                        { name: "Suspicious threshold", value: "0.55" },
                        { name: "Anomaly threshold", value: "0.08" }
                      ].map((item) => (
                        <div
                          key={item.name}
                          className="flex items-center justify-between gap-3 py-3 border-b border-white/5"
                        >
                          <span className="text-xs text-slate-400">
                            {item.name}
                          </span>
                          <span className="font-mono text-xs text-cyan-300">
                            {item.value}
                          </span>
                        </div>
                      ))}

                      <div className="mt-5 rounded-xl bg-cyan-500/5 border border-cyan-500/10 p-3">
                        <div className="text-xs text-cyan-300 font-semibold">
                          Calibration
                        </div>
                        <p className="text-[11px] text-slate-400 mt-1 leading-relaxed">
                          Binary detector probabilities use Platt
                          calibration. Thresholds are read-only here and
                          remain controlled by the deployed V3 configuration.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* CAPTURE & UPLOAD TAB */}
              {tab === "capture" && (
                <div className="glass-card rounded-2xl p-6 max-w-2xl space-y-4">
                  <h2 className="text-base font-semibold text-white">
                    Batch Flow CSV Ingestion
                  </h2>
                  <p className="text-xs text-slate-400">
                    Upload a CIC-IDS2017 / flow-feature CSV directly to{" "}
                    <code className="text-cyan-300">POST /analyze/upload</code>{" "}
                    to score flows and persist detections to PostgreSQL.
                  </p>
                  <input
                    type="file"
                    accept=".csv"
                    onChange={handleCsvUpload}
                    className="block w-full text-xs text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-500/25 file:text-indigo-200 hover:file:bg-indigo-500/35"
                  />
                  {uploadStatus && (
                    <div className="text-xs text-cyan-300 font-mono">
                      {uploadStatus}
                    </div>
                  )}
                </div>
              )}
            </main>
          </div>
        );
      }

      ReactDOM.createRoot(document.getElementById("root")).render(<App />);
    </script>
  </body>
</html>
