@app.post("/analyze/upload")
async def analyze_upload(
    file: UploadFile = File(...),
    max_rows: int = Query(default=1000, ge=1, le=50000),
    persist: bool = Query(default=True),
    db: Session = Depends(get_db),
):
    if not file.filename or not file.filename.lower().endswith(".csv"):
        raise HTTPException(status_code=400, detail="Please upload a .csv file.")

    raw_bytes = await file.read()
    if not raw_bytes:
        raise HTTPException(status_code=400, detail="Uploaded CSV file is empty.")

    try:
        text = raw_bytes.decode("utf-8", errors="replace")
        df = pd.read_csv(StringIO(text), low_memory=False)
    except Exception as exc:
        raise HTTPException(status_code=400, detail=f"Failed to parse CSV: {exc}") from exc

    if df.empty:
        raise HTTPException(status_code=400, detail="CSV contains zero rows.")

    df = df.head(max_rows).copy()
    df.columns = [str(c).strip().lower().replace(" ", "_") if str(c).strip().lower() not in RAW_COL_RENAME else RAW_COL_RENAME[str(c).strip().lower()] for c in df.columns]

    detector = get_detector()
    decisions = detector.predict_dataframe(df)

    persisted_stats = {"flows_persisted": 0, "alerts_created": 0, "evidence_records_created": 0}
    if persist:
        persisted_stats = _persist_decisions(db, df, decisions, source_name=file.filename)

    tier_counts = {"benign": 0, "suspicious": 0, "confirmed_malicious": 0}
    for d in decisions:
        tier_counts[d["level"]] = tier_counts.get(d["level"], 0) + 1

    return {
        "filename": file.filename,
        "rows_analyzed": len(decisions),
        "tier_counts": tier_counts,
        "persistence": persisted_stats,
        "results": decisions[:100],
    }




@app.post("/analyze/flows")
def analyze_flows(
    payload: FlowBatchRequest,
    persist: bool = Query(default=True),
    db: Session = Depends(get_db),
):
    if not payload.flows:
        raise HTTPException(status_code=400, detail="Request contains zero flows.")

    rows = []
    for item in payload.flows:
        row = dict(item.features)
        row["src_ip"] = item.src_ip
        row["dst_ip"] = item.dst_ip
        row["src_port"] = item.src_port
        row["dst_port"] = item.dst_port
        row["proto"] = item.proto
        rows.append(row)

    df = pd.DataFrame(rows)
    detector = get_detector()
    decisions = detector.predict_dataframe(df)

    persisted_stats = {"flows_persisted": 0, "alerts_created": 0, "evidence_records_created": 0}
    if persist:
        persisted_stats = _persist_decisions(db, df, decisions, source_name=payload.source or "live")

    tier_counts = {"benign": 0, "suspicious": 0, "confirmed_malicious": 0}
    for d in decisions:
        tier_counts[d["level"]] = tier_counts.get(d["level"], 0) + 1

    return {
        "source": payload.source or "live",
        "flows_analyzed": len(decisions),
        "tier_counts": tier_counts,
        "persistence": persisted_stats,
        "results": decisions[:100],
    }


@app.get("/alerts")
def list_alerts(
    level: Optional[str] = Query(default=None, description="Filter by benign, suspicious, or confirmed_malicious"),
    attack_class: Optional[str] = Query(default=None),
    limit: int = Query(default=50, ge=1, le=500),
    db: Session = Depends(get_db),
):
    alerts_table = Base.metadata.tables.get("alerts")
    if alerts_table is None:
        return {"count": 0, "alerts": []}

    stmt = select(alerts_table)
    if level and "level" in alerts_table.c:
        stmt = stmt.where(alerts_table.c.level == level)
    elif level and "severity" in alerts_table.c:
        stmt = stmt.where(alerts_table.c.severity == level)

    if attack_class and "attack_class" in alerts_table.c:
        stmt = stmt.where(alerts_table.c.attack_class == attack_class)

    order_col = alerts_table.c.id if "id" in alerts_table.c else list(alerts_table.columns)[0]
    stmt = stmt.order_by(desc(order_col)).limit(limit)

    rows = db.execute(stmt).mappings().all()
    serialized = []
    for r in rows:
        item = {}
        for k, v in r.items():
            if isinstance(v, datetime):
                item[k] = v.isoformat()
            elif isinstance(v, str) and v.startswith(("{", "[")):
                try:
                    item[k] = json.loads(v)
                except Exception:
                    item[k] = v
            else:
                item[k] = v
        serialized.append(item)

    return {"count": len(serialized), "alerts": serialized}


