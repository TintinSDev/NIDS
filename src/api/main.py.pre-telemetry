@app.get("/traffic/summary")
def get_traffic_summary(limit_flows: int = Query(default=500, ge=10, le=5000), db: Session = Depends(get_db)):
    flows_table = Base.metadata.tables.get("flows")
    if flows_table is None:
        return {"total_sampled": 0, "protocols": {}, "top_talkers": [], "top_ports": []}

    stmt = flows_table.select()
    if "id" in flows_table.c:
        stmt = stmt.order_by(flows_table.c.id.desc())
    rows = [dict(r) for r in db.execute(stmt.limit(limit_flows)).mappings().all()]

    proto_counts: Dict[str, int] = {}
    host_stats: Dict[str, Dict[str, Any]] = {}
    port_counts: Dict[int, int] = {}

    for r in rows:
        proto = str(r.get("proto") or "Other").upper()
        if proto not in ("TCP", "UDP", "ICMP"):
            proto = "Other"
        proto_counts[proto] = proto_counts.get(proto, 0) + 1

        src_ip = str(r.get("src_ip") or "0.0.0.0")
        fv = r.get("feature_vector") or {}
        if isinstance(fv, str):
            try:
                fv = json.loads(fv)
            except Exception:
                fv = {}
        byte_total = float(fv.get("total_length_fwd_packets", 0.0)) + float(fv.get("total_length_bwd_packets", 0.0))

        if src_ip not in host_stats:
            host_stats[src_ip] = {"host": src_ip, "flows": 0, "bytes": 0.0}
        host_stats[src_ip]["flows"] += 1
        host_stats[src_ip]["bytes"] += byte_total

        dst_port = int(r.get("dst_port") or 0)
        if dst_port > 0:
            port_counts[dst_port] = port_counts.get(dst_port, 0) + 1

    top_talkers = sorted(host_stats.values(), key=lambda x: x["flows"], reverse=True)[:5]
    for t in top_talkers:
        t["mb"] = round(t["bytes"] / (1024 * 1024), 2)

    top_ports = [
        {"port": port, "count": cnt}
        for port, cnt in sorted(port_counts.items(), key=lambda x: x[1], reverse=True)[:5]
    ]

    return {
        "total_sampled": len(rows),
        "protocols": proto_counts,
        "top_talkers": top_talkers,
        "top_ports": top_ports,
    }



@app.get("/traffic/timeseries")
def get_traffic_timeseries(
    window: str = Query(default="15m"),
    db: Session = Depends(get_db),
):
    from sqlalchemy import text

    windows = {
        "1m": (60, 5),
        "15m": (900, 30),
        "1h": (3600, 120),
        "24h": (86400, 900),
    }

    if window not in windows:
        raise HTTPException(
            status_code=400,
            detail="window must be one of: 1m, 15m, 1h, 24h",
        )

    window_seconds, bucket_seconds = windows[window]

    query = text("""
        WITH params AS (
            SELECT
                now() AS end_at,
                now() - make_interval(secs => :window_seconds) AS start_at,
                CAST(:bucket_seconds AS integer) AS bucket_seconds
        ),
        buckets AS (
            SELECT generate_series(
                to_timestamp(
                    floor(extract(epoch FROM p.start_at) / p.bucket_seconds)
                    * p.bucket_seconds
                ),
                to_timestamp(
                    floor(extract(epoch FROM p.end_at) / p.bucket_seconds)
                    * p.bucket_seconds
                ),
                make_interval(secs => p.bucket_seconds)
            ) AS bucket
            FROM params p
        ),
        aggregated AS (
            SELECT
                to_timestamp(
                    floor(extract(epoch FROM f.ts) / p.bucket_seconds)
                    * p.bucket_seconds
                ) AS bucket,
                SUM(COALESCE(
                    NULLIF(f.feature_vector->>'total_length_fwd_packets', '')::double precision,
                    0
                )) AS forward_bytes,
                SUM(COALESCE(
                    NULLIF(f.feature_vector->>'total_length_bwd_packets', '')::double precision,
                    0
                )) AS reverse_bytes,
                COUNT(*) FILTER (
                    WHERE a.id IS NULL OR a.level = 'benign'
                ) AS benign,
                COUNT(*) FILTER (
                    WHERE a.level = 'suspicious'
                ) AS suspicious,
                COUNT(*) FILTER (
                    WHERE a.level = 'confirmed_malicious'
                ) AS malicious
            FROM flows f
            CROSS JOIN params p
            LEFT JOIN alerts a ON a.flow_id = f.id
            WHERE f.source = 'live'
              AND f.ts >= p.start_at
              AND f.ts <= p.end_at
            GROUP BY 1
        )
        SELECT
            b.bucket,
            COALESCE(a.forward_bytes, 0) AS forward_bytes,
            COALESCE(a.reverse_bytes, 0) AS reverse_bytes,
            COALESCE(a.benign, 0) AS benign,
            COALESCE(a.suspicious, 0) AS suspicious,
            COALESCE(a.malicious, 0) AS malicious
        FROM buckets b
        LEFT JOIN aggregated a ON a.bucket = b.bucket
        ORDER BY b.bucket
    """)

    rows = db.execute(query, {
        "window_seconds": window_seconds,
        "bucket_seconds": bucket_seconds,
    }).mappings().all()

    return {
        "window": window,
        "bucket_seconds": bucket_seconds,
        "source": "live",
        "points": [
            {
                "timestamp": row["bucket"].isoformat(),
                "forward_bytes_per_sec": round(float(row["forward_bytes"]) / bucket_seconds, 2),
                "reverse_bytes_per_sec": round(float(row["reverse_bytes"]) / bucket_seconds, 2),
                "benign": int(row["benign"]),
                "suspicious": int(row["suspicious"]),
                "malicious": int(row["malicious"]),
            }
            for row in rows
        ],
    }


@app.get("/")
def serve_dashboard():
    index_file = Path("src/api/static/index.html")
    if not index_file.exists():
        raise HTTPException(status_code=404, detail="Dashboard UI not built yet.")
    return FileResponse(index_file)


@app.get("/capture/status")
def get_capture_status(db: Session = Depends(get_db)):
    flows_table = Base.metadata.tables.get("flows")
    last_live_at = None
    live_count = 0
    if flows_table is not None:
        rows = db.execute(
            flows_table.select().where(flows_table.c.source == "live").order_by(flows_table.c.id.desc())
        ).mappings().all()
        live_count = len(rows)
        if rows:
            ts = rows[0].get("created_at") or rows[0].get("timestamp")
            last_live_at = ts.isoformat() if hasattr(ts, "isoformat") else (str(ts) if ts else None)

    return {
        "interface": os.getenv("NIDS_CAPTURE_IFACE", "wlo1"),
        "bpf_filter": os.getenv("NIDS_BPF_FILTER", "ip and (tcp or udp or icmp)"),
        "worker_active": live_count > 0,
        "live_flows_total": live_count,
        "last_live_ingest": last_live_at,
    }
