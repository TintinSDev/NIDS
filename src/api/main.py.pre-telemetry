def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def get_detector() -> NIDSDetectionEngine:
    global _engine_instance
    if _engine_instance is None:
        art_dir = Path(os.getenv("NIDS_ARTIFACTS_DIR", "artifacts/models/v3"))
        _engine_instance = NIDSDetectionEngine(artifacts_dir=art_dir)
    return _engine_instance


def _build_row_for_table(table_name: str, candidate: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    table = Base.metadata.tables.get(table_name)
    if table is None:
        return None
    row: Dict[str, Any] = {}
    for col in table.columns:
        if col.primary_key and col.autoincrement:
            continue
        if col.name in candidate:
            row[col.name] = candidate[col.name]
    return row


def _persist_decisions(
    db: Session,
    df: pd.DataFrame,
    decisions: List[Dict[str, Any]],
    source_name: str,
) -> Dict[str, int]:
    now = datetime.now(timezone.utc)
    flows_table = Base.metadata.tables.get("flows")
    alerts_table = Base.metadata.tables.get("alerts")
    evidence_table = Base.metadata.tables.get("alert_evidence")
    audit_table = Base.metadata.tables.get("audit_log")

    inserted_flows = 0
    inserted_alerts = 0
    inserted_evidence = 0
    schema_cols = get_detector().features

    for idx, dec in enumerate(decisions):
        src_row = df.iloc[idx]
        src_ip = str(src_row.get("src_ip", src_row.get("source_ip", "0.0.0.0")))
        dst_ip = str(src_row.get("dst_ip", src_row.get("destination_ip", "0.0.0.0")))
        src_port = int(pd.to_numeric(src_row.get("src_port", src_row.get("source_port", 0)), errors="coerce") or 0)
        dst_port = int(pd.to_numeric(src_row.get("dst_port", src_row.get("destination_port", 0)), errors="coerce") or 0)
        proto = str(src_row.get("proto", src_row.get("protocol", "TCP")))

        feat_dict = {
            k: float(pd.to_numeric(src_row.get(k, 0.0), errors="coerce") or 0.0)
            for k in schema_cols
        }
        feat_val = feat_dict if True else json.dumps(feat_dict)

        flow_id = None
        if flows_table is not None:
            flow_payload = _build_row_for_table(
                "flows",
                {
                    "ts": now,
                    "src_ip": src_ip,
                    "dst_ip": dst_ip,
                    "src_port": src_port,
                    "dst_port": dst_port,
                    "proto": proto,
                    "feature_vector": feat_val,
                    "source": source_name,
                },
            )
            if flow_payload:
                res = db.execute(flows_table.insert().values(**flow_payload).returning(flows_table.c.id))
                flow_id = res.scalar_one_or_none()
                inserted_flows += 1

        if dec["level"] in {"suspicious", "confirmed_malicious"} and alerts_table is not None:
            alert_payload = _build_row_for_table(
                "alerts",
                {
                    "flow_id": flow_id,
                    "level": dec["level"],
                    "attack_class": dec["attack_class"],
                    "confidence": float(dec["confidence"]),
                    "anomaly_score": float(dec["anomaly_score"]),
                    "model_version": dec["model_version"],
                    "status": "open",
                    "created_at": now,
                },
            )
            if alert_payload:
                ares = db.execute(alerts_table.insert().values(**alert_payload).returning(alerts_table.c.id))
                alert_id = ares.scalar_one_or_none()
                inserted_alerts += 1

                if evidence_table is not None and alert_id is not None:
                    shap_val = dec.get("shap_values", []) if True else json.dumps(dec.get("shap_values", []))
                    det_val = dec.get("detector_scores", {}) if True else json.dumps(dec.get("detector_scores", {}))
                    ev_payload = _build_row_for_table(
                        "alert_evidence",
                        {
                            "alert_id": alert_id,
                            "shap_values": shap_val,
                            "detector_scores": det_val,
                            "notes": f"Source file: {source_name}",
                        },
                    )
                    if ev_payload:
                        db.execute(evidence_table.insert().values(**ev_payload))
                        inserted_evidence += 1

    if audit_table is not None:
        audit_payload = _build_row_for_table(
            "audit_log",
            {
                "action": "analyze_upload",
                "target": source_name,
                "details": json.dumps(
                    {
                        "rows_analyzed": len(decisions),
                        "alerts_created": inserted_alerts,
                    }
                ),
                "created_at": now,
            },
        )
        if audit_payload:
            db.execute(audit_table.insert().values(**audit_payload))

    db.commit()
    return {
        "flows_persisted": inserted_flows,
        "alerts_created": inserted_alerts,
        "evidence_records_created": inserted_evidence,
    }


