@app.get("/alerts/{alert_id}")
def get_alert_detail(alert_id: int, db: Session = Depends(get_db)):
    alerts_table = Base.metadata.tables.get("alerts")
    evidence_table = Base.metadata.tables.get("alert_evidence")
    flows_table = Base.metadata.tables.get("flows")

    if alerts_table is None:
        raise HTTPException(status_code=404, detail="Alerts table not available.")

    arow = db.execute(
        alerts_table.select().where(alerts_table.c.id == alert_id)
    ).mappings().first()
    if not arow:
        raise HTTPException(status_code=404, detail=f"Alert {alert_id} not found.")

    alert_obj = dict(arow)
    if flows_table is not None and alert_obj.get("flow_id") is not None:
        frow = db.execute(
            flows_table.select().where(flows_table.c.id == alert_obj["flow_id"])
        ).mappings().first()
        if frow:
            fdict = dict(frow)
            fdict.pop("feature_vector", None)
            alert_obj["flow"] = fdict

    evidence_list = []
    if evidence_table is not None:
        erows = db.execute(
            evidence_table.select().where(evidence_table.c.alert_id == alert_id)
        ).mappings().all()
        evidence_list = [dict(e) for e in erows]

    alert_obj["evidence"] = evidence_list
    return alert_obj


@app.patch("/alerts/{alert_id}/status")
def update_alert_status(
    alert_id: int,
    status: str = Query(..., pattern="^(open|acknowledged|resolved|false_positive)$"),
    db: Session = Depends(get_db),
):
    alerts_table = Base.metadata.tables.get("alerts")
    if alerts_table is None:
        raise HTTPException(status_code=404, detail="Alerts table not available.")

    existing = db.execute(
        alerts_table.select().where(alerts_table.c.id == alert_id)
    ).mappings().first()
    if not existing:
        raise HTTPException(status_code=404, detail=f"Alert {alert_id} not found.")

    db.execute(
        alerts_table.update()
        .where(alerts_table.c.id == alert_id)
        .values(status=status)
    )
    db.commit()
    return {"id": alert_id, "status": status}


